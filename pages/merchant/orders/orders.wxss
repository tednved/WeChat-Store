page{height:100%;overflow:hidden;background:#f6f7fb}.merchant-orders-shell{display:flex;flex-direction:column;height:100vh;overflow:hidden}.fixed-head{flex:none;padding:22rpx 24rpx 0}.orders-body{flex:1;height:0;min-height:0}.page{min-height:100%;padding:0 24rpx calc(140rpx + env(safe-area-inset-bottom));box-sizing:border-box}.tabs{display:flex;width:100%;height:76rpx;margin-bottom:20rpx;white-space:nowrap;background:#fff;border-radius:18rpx}.tab{display:inline-block;height:76rpx;padding:0 24rpx;color:#858b96;line-height:76rpx;font-size:25rpx}.tab.active{border-bottom:5rpx solid #ff4a4a;color:#ff4a4a;font-weight:600}.empty{padding:150rpx 0;color:#999;text-align:center;font-size:27rpx}.order-card{padding:24rpx;margin-bottom:22rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(32,38,50,.055);transition:transform .15s}.card-hover{transform:scale(.985)}.order-header,.summary,.card-footer{display:flex;align-items:center}.order-header{justify-content:space-between}.store-name{display:flex;align-items:center;color:#262a30;font-size:28rpx;font-weight:650}.store-badge{margin-right:10rpx;padding:2rpx 8rpx;border-radius:6rpx;background:#ff4a4a;color:#fff;font-size:20rpx}.arrow{margin-left:10rpx;color:#aaa;font-size:34rpx}.order-status{color:#ff4a4a;font-size:25rpx;font-weight:600}.order-status.refunding{color:#e98b2a}.order-status.refunded{color:#07a85a}.summary{margin-top:22rpx;padding:18rpx;border-radius:16rpx;background:#f8f8f8}.cover{width:104rpx;height:104rpx;flex:none;border-radius:12rpx;background:#eee}.summary-main{min-width:0;flex:1;margin-left:18rpx}.goods-name,.summary-meta{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.goods-name{color:#30343a;font-size:27rpx}.summary-meta{margin-top:14rpx;color:#969ba3;font-size:21rpx}.amount{text-align:right}.amount text{display:block;color:#202329;font-size:29rpx;font-weight:700}.amount .paid{margin-top:8rpx;color:#999;font-size:19rpx;font-weight:400}.address{overflow:hidden;padding:18rpx 2rpx 0;color:#7d828a;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.card-footer{justify-content:flex-end;gap:14rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #f1f2f4}.contact-btn,.reject-btn,.action-btn{box-sizing:border-box;width:132rpx;height:56rpx;margin:0;padding:0;border-radius:28rpx;line-height:54rpx;font-size:22rpx}.contact-btn::after,.reject-btn::after,.action-btn::after{border:0}.contact-btn{border:1rpx solid #ddd;background:#fff;color:#555}.reject-btn{border:1rpx solid #ffd4d4;background:#fff;color:#f05b5b}.action-btn{background:#ff4a4a;color:#fff}.reject-btn[disabled],.action-btn[disabled]{opacity:.45}
