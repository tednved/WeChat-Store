<view class="merchant-orders-shell">
  <navigation-bar title="订单管理" back="{{true}}" />
  <view class="fixed-head"><scroll-view class="tabs" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="selectTab">全部</view><view class="tab {{currentTab === 'waiting_accept' ? 'active' : ''}}" data-tab="waiting_accept" bindtap="selectTab">待接单</view><view class="tab {{currentTab === 'accepted' ? 'active' : ''}}" data-tab="accepted" bindtap="selectTab">已接单</view><view class="tab {{currentTab === 'preparing' ? 'active' : ''}}" data-tab="preparing" bindtap="selectTab">制作中</view><view class="tab {{currentTab === 'delivering' ? 'active' : ''}}" data-tab="delivering" bindtap="selectTab">配送中</view><view class="tab {{currentTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="selectTab">已完成</view><view class="tab {{currentTab === 'refunding' ? 'active' : ''}}" data-tab="refunding" bindtap="selectTab">退款中</view><view class="tab {{currentTab === 'refunded' ? 'active' : ''}}" data-tab="refunded" bindtap="selectTab">已退款</view>
  </scroll-view></view>
  <scroll-view class="orders-body" scroll-y="true" enhanced="true" show-scrollbar="false" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onScrollRefresh"><view class="page">
    <view wx:if="{{loading}}" class="empty">正在加载订单...</view><view wx:elif="{{orders.length === 0}}" class="empty">暂无订单</view>
    <view wx:else><view wx:for="{{orders}}" wx:key="_id" class="order-card" hover-class="card-hover" data-id="{{item._id}}" bindtap="goOrderDetail">
      <view class="order-header"><view class="store-name"><text class="store-badge">店</text><text>{{item.storeName || item.storeId}}</text><text class="arrow">›</text></view><text class="order-status {{item.displayStatus}}">{{item.merchantStatusText}}</text></view>
      <view class="summary"><image class="cover" src="{{item.items[0].image}}" mode="aspectFill" /><view class="summary-main"><text class="goods-name">{{item.items[0].name}}{{item.items.length > 1 ? ' 等商品' : ''}}</text><text class="summary-meta">共 {{item.items.length}} 种商品 · {{item.timeStr}}</text></view><view class="amount"><text>¥{{item.totalPrice}}</text><text class="paid">实付</text></view></view>
      <view wx:if="{{item.addressDetail}}" class="address">送至：{{item.addressDetail}}</view>
      <view class="card-footer"><button wx:if="{{item.contactPhone}}" class="contact-btn" data-id="{{item._id}}" catchtap="callCustomer">联系用户</button><button wx:if="{{item.merchantStatus === 'waiting_accept'}}" class="reject-btn" disabled="{{busyId === item._id || item.refundStatus === 'requesting' || item.refundStatus === 'processing' || item.refundStatus === 'refunded'}}" data-id="{{item._id}}" catchtap="rejectOrder">{{item.refundStatus === 'refunded' ? '已退款' : item.refundStatus === 'requesting' || item.refundStatus === 'processing' ? '退款中' : '拒单退款'}}</button><button wx:if="{{item.merchantStatus === 'waiting_accept' || item.merchantStatus === 'accepted' || item.merchantStatus === 'preparing' || item.merchantStatus === 'delivering'}}" disabled="{{busyId === item._id || item.refundStatus === 'requesting' || item.refundStatus === 'processing' || item.refundStatus === 'refunded'}}" class="action-btn" data-id="{{item._id}}" data-status="{{item.merchantStatus}}" data-next="{{item.merchantStatus === 'waiting_accept' ? 'accepted' : item.merchantStatus === 'accepted' ? 'preparing' : item.merchantStatus === 'preparing' ? 'delivering' : 'completed'}}" catchtap="updateStatus">{{item.merchantStatus === 'waiting_accept' ? '接单' : item.merchantStatus === 'accepted' ? '开始制作' : item.merchantStatus === 'preparing' ? '开始配送' : '完成订单'}}</button></view>
    </view></view>
  </view></scroll-view>
</view>
