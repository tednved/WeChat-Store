<view class="detail-shell"><navigation-bar title="订单详情" back="{{true}}"/><scroll-view class="detail-scroll" scroll-y="true" enhanced="true" show-scrollbar="false"><view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载...</view><block wx:elif="{{order}}">
    <view class="status-card status-{{order.displayStatus}}"><text class="status">{{order.merchantStatusText}}</text><text class="status-tip">{{order.displayStatus === 'refunding' ? '退款结果以微信支付处理为准' : order.displayStatus === 'refunded' ? '款项已原路退还给用户' : '订单状态已由服务器确认'}}</text></view>
    <view class="card address-card"><view class="address-icon">送</view><view class="address-main"><text class="contact">{{order.contactName}}  {{order.contactPhone}}</text><text class="address">{{order.addressDetail || '未填写配送地址'}}</text></view><text wx:if="{{order.contactPhone}}" class="phone" bindtap="callCustomer">联系</text></view>
    <view class="card"><view class="card-title">商品明细</view><view wx:for="{{order.items}}" wx:key="id" class="goods"><image src="{{item.image}}" mode="aspectFill"/><view class="goods-main"><text>{{item.name}}</text><text class="count">x{{item.count}}</text></view><text class="price">¥{{item.price}}</text></view><view class="money-row"><text>商品合计</text><text>¥{{order.totalPrice}}</text></view><view class="money-row total"><text>实付金额</text><text>¥{{order.totalPrice}}</text></view></view>
    <view wx:if="{{order.remark}}" class="card info-row"><text>订单备注</text><text class="info-value">{{order.remark}}</text></view>
    <view class="card info-card"><view class="card-title">订单信息</view><view class="info-row"><text>订单编号</text><text class="info-value">{{order._id}}</text></view><view class="info-row"><text>下单时间</text><text class="info-value">{{order.timeStr}}</text></view><view wx:if="{{order.transactionId}}" class="info-row"><text>支付单号</text><text class="info-value">{{order.transactionId}}</text></view><view wx:if="{{order.refundNo}}" class="info-row"><text>退款单号</text><text class="info-value">{{order.refundNo}}</text></view><view wx:if="{{order.refundReason}}" class="info-row"><text>退款原因</text><text class="info-value">{{order.refundReason}}</text></view></view>
  </block>
</view></scroll-view><view wx:if="{{order}}" class="bottom-bar"><button wx:if="{{order.contactPhone}}" class="plain" bindtap="callCustomer">联系用户</button><button wx:if="{{order.merchantStatus === 'waiting_accept'}}" class="danger" disabled="{{busy || refundActive || order.refundStatus === 'refunded'}}" bindtap="rejectOrder">{{refundActive ? '退款中' : order.refundStatus === 'refunded' ? '已退款' : '拒单退款'}}</button><button wx:if="{{nextAction}}" class="primary" disabled="{{busy || refundActive || order.refundStatus === 'refunded'}}" bindtap="updateStatus">{{nextAction.text}}</button></view></view>
