page{height:100%;overflow:hidden;background:#f5f5f5;color:#292c31}.detail-shell{display:flex;flex-direction:column;height:100vh;overflow:hidden}.detail-scroll{flex:1;height:0;min-height:0}.page{min-height:100%;padding:24rpx 24rpx calc(200rpx + env(safe-area-inset-bottom));box-sizing:border-box}.empty{padding:180rpx 0;text-align:center;color:#999}.status-card{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#ff6548,#ff8a52);color:#fff}.status-card.status-refunded{background:linear-gradient(135deg,#20a86d,#52c990)}.status-card.status-refunding{background:linear-gradient(135deg,#e68b29,#f2ad4e)}.status,.status-tip{display:block}.status{font-size:36rpx;font-weight:700}.status-tip{margin-top:12rpx;font-size:23rpx;opacity:.88}.card{margin-top:20rpx;padding:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 24rpx rgba(28,34,44,.045)}.address-card{display:flex;align-items:center}.address-icon{width:62rpx;height:62rpx;flex:none;border-radius:50%;background:#fff0eb;color:#ff6244;text-align:center;line-height:62rpx;font-size:23rpx}.address-main{min-width:0;flex:1;margin-left:18rpx}.contact,.address{display:block}.contact{font-size:27rpx;font-weight:650}.address{margin-top:9rpx;color:#777d85;font-size:23rpx;line-height:1.45}.phone{padding:14rpx;color:#ff5a3c;font-size:24rpx}.card-title{padding-bottom:18rpx;font-size:29rpx;font-weight:700}.goods{display:flex;align-items:center;padding:14rpx 0}.goods image{width:96rpx;height:96rpx;border-radius:12rpx;background:#eee}.goods-main{min-width:0;flex:1;margin-left:16rpx;font-size:26rpx}.goods-main text{display:block}.goods-main .count{margin-top:10rpx;color:#999;font-size:22rpx}.price{font-size:26rpx}.money-row,.info-row{display:flex;justify-content:space-between;padding:15rpx 0;color:#696e76;font-size:24rpx}.money-row.total{margin-top:8rpx;padding-top:22rpx;border-top:1rpx solid #f1f2f4;color:#222;font-size:28rpx;font-weight:650}.info-card .info-row{border-top:1rpx solid #f3f4f5}.info-value{max-width:470rpx;overflow-wrap:anywhere;color:#333;text-align:right}.bottom-bar{display:flex;align-items:center;justify-content:flex-end;gap:14rpx;flex:none;padding:16rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -5rpx 20rpx rgba(0,0,0,.05)}.bottom-bar button{box-sizing:border-box;width:146rpx;height:64rpx;margin:0;padding:0;border-radius:32rpx;line-height:62rpx;font-size:23rpx}.bottom-bar button::after{border:0}.plain{border:1rpx solid #ddd;background:#fff;color:#555}.danger{border:1rpx solid #ffd1cc;background:#fff;color:#e95649}.primary{background:#ff513f;color:#fff}.bottom-bar button[disabled]{opacity:.45}
