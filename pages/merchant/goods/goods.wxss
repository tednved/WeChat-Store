page { height: 100%; overflow: hidden; background: #f5f5f5; }
.goods-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.goods-toolbar { display: flex; flex: none; align-items: center; gap: 18rpx; padding: 20rpx 24rpx; }
.goods-scroll { flex: 1; height: 0; min-height: 0; }
.page { min-height: 100%; padding: 0 24rpx calc(100rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; }
.desc { display: block; color: #9297a2; font-size: 24rpx; margin-top: 8rpx; }
.add-btn { margin: 0; padding: 0 24rpx; height: 68rpx; border-radius: 34rpx; background: #ff4a4a; color: #fff; line-height: 68rpx; font-size: 26rpx; }
.add-btn::after, .small-btn::after, .delete-btn::after { border: 0; }
.tabs { display: flex; flex: 1; padding: 6rpx; background: #fff; border-radius: 999rpx; }
.tab { flex: 1; height: 70rpx; color: #858b96; text-align: center; line-height: 70rpx; font-size: 27rpx; }
.tab.active { border-radius: 14rpx; background: #fff0f0; color: #ff4a4a; font-weight: 600; }
.empty { padding: 150rpx 0; color: #999; text-align: center; font-size: 27rpx; }
.goods-card { display: flex; flex-wrap: wrap; align-items: center; padding: 22rpx; margin-bottom: 20rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.045); }
.goods-image { width: 140rpx; height: 140rpx; flex-shrink: 0; border-radius: 16rpx; background: #fff3e8; }
.image-placeholder { color: #f3a36b; text-align: center; line-height: 140rpx; font-size: 38rpx; font-weight: 700; }
.goods-main { min-width: 0; flex: 1; margin-left: 20rpx; }
.goods-title-row { display: flex; align-items: center; }
.goods-name { max-width: 270rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 600; }
.status { margin-left: 12rpx; padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 21rpx; }
.status.on { color: #28a36a; background: #e9f9f0; }
.status.off { color: #9a9fa8; background: #f0f1f4; }
.category { display: block; margin-top: 10rpx; color: #9a9fa8; font-size: 23rpx; }
.goods-bottom { display: flex; align-items: baseline; margin-top: 20rpx; }
.price { color: #ff4a4a; font-size: 32rpx; font-weight: 700; }
.stock { margin-left: 18rpx; color: #9297a2; font-size: 22rpx; }
.actions { display: flex; width: 100%; justify-content: flex-end; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f2f3f5; }
.small-btn, .delete-btn { height: 56rpx; margin: 0 0 0 12rpx; padding: 0 20rpx; border: 1rpx solid #e8e9ed; border-radius: 28rpx; background: #fff; color: #666b74; line-height: 54rpx; font-size: 23rpx; }
.small-btn.primary { border-color: #ffd1d1; background: #fff4f4; color: #ff4a4a; }
.delete-btn { border-color: #ffdede; color: #f05b5b; }
