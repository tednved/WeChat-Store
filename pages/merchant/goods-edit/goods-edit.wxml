<navigation-bar title="商品信息" back="{{true}}" />

<view class="page">
  <view class="form-card">
    <view class="image-field" bindtap="chooseImage">
      <image wx:if="{{image}}" class="preview" src="{{image}}" mode="aspectFill" />
      <view wx:else class="upload-placeholder">
        <text class="upload-icon">+</text>
        <text>上传商品图片</text>
      </view>
    </view>

    <view class="field">
      <text class="label">商品名称</text>
      <input class="input" data-field="name" value="{{name}}" bindinput="onInput" placeholder="例如：冰美式" maxlength="30" />
    </view>
    <view class="row">
      <view class="field half">
        <text class="label">价格（元）</text>
        <input class="input" type="digit" data-field="price" value="{{price}}" bindinput="onInput" placeholder="0.00" />
      </view>
      <view class="field half right-field">
        <text class="label">库存</text>
        <input class="input" type="number" data-field="stock" value="{{stock}}" bindinput="onInput" placeholder="9999" />
      </view>
    </view>
    <view class="field">
      <text class="label">商品分类</text>
      <view class="category-mode"><text class="mode {{!useNewCategory ? 'active' : ''}}" bindtap="useExistingCategory">选择已有分类</text><text class="mode {{useNewCategory ? 'active' : ''}}" bindtap="useNewCategory">新建分类</text></view>
      <picker wx:if="{{!useNewCategory}}" class="picker" range="{{categoryNames}}" value="{{selectedCategoryIndex < 0 ? 0 : selectedCategoryIndex}}" bindchange="onCategorySelect"><view class="picker-value">{{selectedCategoryIndex >= 0 ? categoryName : (categoryNames.length ? '请选择分类' : '暂无已有分类，请新建')}}<text class="picker-arrow">›</text></view></picker>
      <input wx:else class="input" data-field="categoryName" value="{{categoryName}}" bindinput="onInput" placeholder="例如：饮料" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">商品描述</text>
      <textarea class="textarea" data-field="description" value="{{description}}" bindinput="onInput" placeholder="简单介绍商品特点" maxlength="120" />
    </view>
  </view>

  <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存商品</button>
</view>
