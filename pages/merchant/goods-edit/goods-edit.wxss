page { background: #f6f7fb; }
.page { min-height: 100vh; padding: 30rpx; box-sizing: border-box; }
.form-card { padding: 28rpx; border-radius: 20rpx; background: #fff; }
.image-field { width: 220rpx; height: 220rpx; overflow: hidden; border-radius: 18rpx; background: #fff4e9; }
.preview { width: 100%; height: 100%; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #d9935d; font-size: 23rpx; }
.upload-icon { margin-bottom: 12rpx; font-size: 55rpx; font-weight: 200; }
.field { margin-top: 34rpx; }
.label { display: block; margin-bottom: 14rpx; color: #333840; font-size: 27rpx; font-weight: 600; }
.input, .textarea { width: 100%; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #e7e9ed; border-radius: 12rpx; background: #fafbfc; color: #272b31; font-size: 27rpx; }
.input { height: 78rpx; line-height: 78rpx; }
.category-mode { display: flex; margin-bottom: 16rpx; padding: 6rpx; border-radius: 14rpx; background: #f6f7fb; }
.mode { flex: 1; height: 58rpx; border-radius: 10rpx; color: #858b96; text-align: center; line-height: 58rpx; font-size: 24rpx; }
.mode.active { background: #fff; color: #ff4a4a; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.picker { width: 100%; box-sizing: border-box; border: 1rpx solid #e7e9ed; border-radius: 12rpx; background: #fafbfc; }
.picker-value { height: 78rpx; padding: 0 20rpx; color: #555; line-height: 78rpx; font-size: 27rpx; }
.picker-arrow { float: right; color: #aaa; font-size: 34rpx; }
.textarea { min-height: 160rpx; padding-top: 18rpx; }
.row { display: flex; }
.half { flex: 1; }
.right-field { margin-left: 20rpx; }
.save-btn { height: 86rpx; margin-top: 36rpx; border-radius: 43rpx; background: #ff4a4a; color: #fff; line-height: 86rpx; font-size: 30rpx; }
.save-btn::after { border: 0; }
