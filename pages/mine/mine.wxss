page, .mine-page { background-color: #f5f5f5; height: 100vh; }
.user-info {
  background: linear-gradient(135deg, #8fbdb2, #67978d);
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-wrapper {
  padding: 0; width: 140rpx; height: 140rpx; border-radius: 50%;
  background: none; border: none;
}
.avatar-wrapper::after { border: none; }
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background-color: #fff; border: 4rpx solid rgba(255,255,255,0.5); }
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.3);
  box-sizing: border-box;
}
.nickname-input {
  margin-top: 20rpx; color: #fff; font-size: 32rpx; text-align: center; font-weight: bold; width: 300rpx;
}
.menu-list {
  background: #fff; margin-top: 20rpx;
}
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 30rpx 40rpx; border-bottom: 1rpx solid #eee; font-size: 30rpx;
}
.contact-btn {
  padding: 0; background: none; border: none; font-size: 30rpx; color: #333; text-align: left; flex: 1; line-height: 1;
}
.contact-btn::after { border: none; }
.arrow { color: #ccc; }
.status-tip {
  color: #fff;
  font-size: 30rpx;
  line-height: 1.6;
}
.retry-btn {
  margin-top: 20rpx;
  padding: 10rpx 48rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 28rpx;
  line-height: 1.6;
  border-radius: 999rpx;
}
.retry-btn::after { border: none; }
.merchant-entry { background: #fffaf4; }
.merchant-hint { margin-left: auto; margin-right: 20rpx; color: #b28a62; font-size: 23rpx; }
.admin-entry { background: #f4f8ff; }
