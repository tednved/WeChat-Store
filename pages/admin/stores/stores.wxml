<view class="shell"><navigation-bar title="默认店铺管理" back="{{true}}"/><scroll-view class="scroll" scroll-y="true"><view class="page"><view wx:if="{{loading}}" class="empty">正在加载...</view><block wx:else><view wx:if="{{!store}}" class="tip">默认店铺尚未建立，保存后会使用系统配置的店铺 ID 自动创建。</view><view class="card"><view class="row"><text>店铺名称</text><input data-field="name" value="{{name}}" bindinput="input" placeholder="请输入店铺名称"/></view><view class="row"><text>联系电话</text><input data-field="phone" value="{{phone}}" bindinput="input" placeholder="请输入联系电话"/></view><view class="row"><text>店铺简介</text><input data-field="subtitle" value="{{subtitle}}" bindinput="input" placeholder="显示在点单页顶部"/></view><view class="row last"><view><text>营业状态</text><text class="hint">关闭后用户无法进入该店点单</text></view><switch color="#ff5a3c" checked="{{isActive}}" bindchange="active"/></view></view><button class="save" loading="{{saving}}" bindtap="save">保存店铺</button></block></view></scroll-view></view>
