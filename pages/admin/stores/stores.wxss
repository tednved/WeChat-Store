page{height:100%;background:#f5f5f5}.shell{display:flex;flex-direction:column;height:100vh}.scroll{flex:1;height:0}.page{padding:24rpx}.tip,.card{padding:24rpx;border-radius:22rpx;background:#fff}.tip{margin-bottom:20rpx;color:#a26b46;font-size:24rpx}.row{display:flex;align-items:center;min-height:100rpx;border-bottom:1rpx solid #eee}.row.last{border:0}.row input{flex:1;margin-left:24rpx;text-align:right}.row switch{margin-left:auto}.hint{display:block;margin-top:8rpx;color:#999;font-size:21rpx}.save{margin-top:30rpx;border-radius:44rpx;background:#ff5a3c;color:#fff}.empty{padding:160rpx 0;text-align:center;color:#999}
