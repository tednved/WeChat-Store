page { height: 100%; overflow: hidden; background: #f5f5f5; }
.admin-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.admin-scroll { flex: 1; height: 0; min-height: 0; }
.admin-page { min-height: 100%; padding: 24rpx 24rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #252a31; }
.hero { padding: 34rpx 30rpx; border-radius: 28rpx; background: linear-gradient(135deg,#ff704d,#ff9b64); box-shadow: 0 12rpx 30rpx rgba(238,101,62,.18); color: #fff; }
.hero-title,.hero-text,.action-title,.action-desc { display: block; }.hero-title { font-size: 38rpx; font-weight: 700; }.hero-text { margin-top: 12rpx; color: rgba(255,255,255,.88); font-size: 24rpx; line-height: 1.6; }
.section-title { margin: 34rpx 6rpx 18rpx; color: #777d86; font-size: 24rpx; font-weight: 600; }
.action-card { display: flex; align-items: center; margin-bottom: 18rpx; padding: 26rpx 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(30,35,45,.045); }.card-hover { transform: scale(.985); background: #fdfdfd; }
.icon { width: 78rpx; height: 78rpx; flex: none; border-radius: 22rpx; text-align: center; line-height: 78rpx; font-size: 28rpx; font-weight: 700; }.merchant-icon { color: #d97b22; background: #fff1dd; }.admin-icon { color: #e0523f; background: #fff0ed; }.store-icon { color: #367dcc; background: #edf5ff; }
.action-main { min-width: 0; flex: 1; margin-left: 22rpx; }.action-title { font-size: 29rpx; font-weight: 650; }.action-desc { margin-top: 9rpx; color: #969ba3; font-size: 22rpx; }.arrow { margin-left: 16rpx; color: #b8bcc2; font-size: 48rpx; font-weight: 300; }.safe-note { margin: 30rpx 14rpx 0; color: #a1a5ab; font-size: 22rpx; line-height: 1.7; }
.user-list { overflow: hidden; border-radius: 24rpx; background: #fff; }
.user-row { display: flex; align-items: center; padding: 22rpx 24rpx; border-bottom: 1rpx solid #f1f2f4; }
.user-row:last-child { border-bottom: 0; }
.user-avatar { width: 72rpx; height: 72rpx; flex: none; border-radius: 50%; background: #f1f2f4; }
.user-avatar.placeholder { color: #8f949c; text-align: center; line-height: 72rpx; }
.user-main { min-width: 0; flex: 1; margin-left: 20rpx; }
.user-name,.user-meta { display: block; }
.user-name { font-size: 27rpx; }
.user-meta { margin-top: 8rpx; color: #9297a0; font-size: 21rpx; }
.user-empty { padding: 50rpx 0; border-radius: 24rpx; background: #fff; color: #999; text-align: center; }
