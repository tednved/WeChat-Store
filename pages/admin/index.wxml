<view class="admin-shell">
  <navigation-bar title="管理员设置" back="{{true}}" />
  <scroll-view class="admin-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="admin-page">
      <view class="hero"><text class="hero-title">权限与店铺</text><text class="hero-text">通过一次性邀请开通权限，不再展示全部消费者资料。</text></view>
      <view class="section-title">权限邀请</view>
      <view class="action-card" data-role="merchant" bindtap="goInvite" hover-class="card-hover"><view class="icon merchant-icon">商</view><view class="action-main"><text class="action-title">邀请商户</text><text class="action-desc">受邀者确认后加入默认店铺</text></view><text class="arrow">›</text></view>
      <view class="action-card" data-role="admin" bindtap="goInvite" hover-class="card-hover"><view class="icon admin-icon">管</view><view class="action-main"><text class="action-title">邀请管理员</text><text class="action-desc">管理员同时具备商户操作权限</text></view><text class="arrow">›</text></view>
      <view class="section-title">店铺配置</view>
      <view class="action-card" bindtap="goStoreManagement" hover-class="card-hover"><view class="icon store-icon">店</view><view class="action-main"><text class="action-title">默认店铺管理</text><text class="action-desc">维护店铺名称、营业状态及展示信息</text></view><text class="arrow">›</text></view>
      <view class="section-title">账户管理</view>
      <view wx:if="{{loadingUsers}}" class="user-empty">正在加载账户...</view>
      <view wx:elif="{{users.length === 0}}" class="user-empty">暂无账户</view>
      <view wx:else class="user-list">
        <view wx:for="{{users}}" wx:key="_id" class="user-row" data-id="{{item._id}}" bindtap="goUserDetail">
          <image wx:if="{{item.avatarUrl}}" class="user-avatar" src="{{item.avatarUrl}}" />
          <view wx:else class="user-avatar placeholder">人</view>
          <view class="user-main"><text class="user-name">{{item.nickname || '未设置昵称'}}</text><text class="user-meta">{{item.role === 'admin' ? '管理员' : item.role === 'merchant' ? '商户' : '普通用户'}} · {{item.isActive ? '已启用' : '已停用'}}</text></view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="safe-note">邀请链接 24 小时有效且只能领取一次。请仅发送给可信任的人员。</view>
    </view>
  </scroll-view>
</view>
