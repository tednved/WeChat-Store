page { height:100%; overflow:hidden; background:#f6f6f6; color:#282b30; }.detail-shell{display:flex;flex-direction:column;height:100vh;overflow:hidden}.detail-scroll{flex:1;height:0;min-height:0}.page{min-height:100%;padding:24rpx 24rpx calc(80rpx + env(safe-area-inset-bottom));box-sizing:border-box}.empty{padding:180rpx 0;text-align:center;color:#999}.profile-card{display:flex;align-items:center;flex-wrap:wrap;padding:30rpx;border-radius:26rpx;background:linear-gradient(135deg,#fff,#fff7f3);box-shadow:0 8rpx 30rpx rgba(40,35,30,.05)}.avatar{width:94rpx;height:94rpx;margin-right:22rpx;border-radius:50%;background:#edf2ff}.placeholder{text-align:center;line-height:94rpx;color:#668ed5}.nickname{max-width:360rpx;font-size:32rpx;font-weight:700}.self-tag{margin-left:12rpx;padding:5rpx 10rpx;border-radius:9rpx;background:#fff0e8;color:#ed7242;font-size:20rpx}.openid{width:calc(100% - 116rpx);margin:8rpx 0 0 116rpx;overflow:hidden;color:#9a9fa7;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.section-title{margin:30rpx 8rpx 14rpx;color:#898e96;font-size:24rpx}.form-card{padding:0 24rpx;border-radius:24rpx;background:#fff}.row{display:flex;align-items:center;min-height:100rpx;border-bottom:1rpx solid #f1f2f4;font-size:27rpx}.row.last{border-bottom:0}.row>picker,.row>switch{margin-left:auto}.row>input{min-width:0;flex:1;margin-left:30rpx;text-align:right;font-size:25rpx}.value{color:#686d75}.value text{margin-left:12rpx;color:#bbb}.row-title,.hint{display:block}.hint{margin-top:6rpx;color:#a3a7ad;font-size:21rpx}.save-btn{height:88rpx;margin-top:34rpx;border-radius:44rpx;background:linear-gradient(90deg,#ff704d,#ff4b3e);color:#fff;line-height:88rpx;font-size:29rpx;font-weight:600}.save-btn::after{border:0}.safe-tip{display:block;margin-top:18rpx;color:#a3a7ad;text-align:center;font-size:21rpx}
.store-select{border-bottom:1rpx solid #f1f2f4}.store-select:last-child{border-bottom:0}.store-line,.notify-line{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;font-size:26rpx}.notify-line{padding-left:30rpx;color:#777;font-size:23rpx}.check{width:38rpx;height:38rpx;border:2rpx solid #ddd;border-radius:50%;text-align:center;line-height:38rpx}.check.checked{border-color:#ff5a3c;background:#ff5a3c;color:#fff}
