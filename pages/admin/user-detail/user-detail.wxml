<view class="detail-shell"><navigation-bar title="账号详情" back="{{true}}"/><scroll-view class="detail-scroll" scroll-y="true"><view class="page"><view wx:if="{{loading}}" class="empty">正在加载...</view><block wx:elif="{{user}}"><view class="profile-card"><image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}"/><view wx:else class="avatar placeholder">人</view><text class="nickname">{{user.nickname}}</text><text wx:if="{{user.isSelf}}" class="self-tag">当前账号</text><text class="openid">{{user.openid}}</text></view><view class="section-title">权限与账号</view><view class="form-card"><view class="row"><view><text class="row-title">商户权限</text><text class="hint">开启后自动加入默认店铺</text></view><switch color="#ff5a3c" checked="{{user.merchantEnabled}}" bindchange="onMerchantChange" disabled="{{user.isSelf}}"/></view><view wx:if="{{user.merchantEnabled}}" class="row"><text>联系电话</text><input type="number" value="{{user.phone}}" bindinput="onPhoneInput" placeholder="选填"/></view><view wx:if="{{user.merchantEnabled}}" class="row"><view><text class="row-title">新订单通知</text><text class="hint">接收默认店铺的新订单提醒</text></view><switch color="#ff5a3c" checked="{{user.notifyEnabled}}" bindchange="onNotifyChange"/></view><view class="row last"><view><text class="row-title">启用账号</text><text class="hint">停用后管理权限不可用</text></view><switch color="#ff5a3c" checked="{{user.isActive}}" bindchange="onActiveChange" disabled="{{user.isSelf}}"/></view></view><button class="save-btn" loading="{{saving}}" bindtap="save">保存设置</button></block></view></scroll-view></view>
