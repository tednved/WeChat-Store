page{height:100%;background:#f5f5f5}.shell{height:100vh}.page{padding:40rpx 24rpx}.card{padding:36rpx;border-radius:26rpx;background:#fff}.title,.hint,.state{display:block}.title{font-size:34rpx;font-weight:700}.hint{margin-top:16rpx;color:#888;font-size:24rpx}.state{margin:36rpx 0;color:#ef7648;text-align:center}.roles{display:flex;gap:20rpx;margin:36rpx 0}.role{flex:1;padding:28rpx;border:2rpx solid #eee;border-radius:18rpx;text-align:center}.role.active{border-color:#ff5a3c;background:#fff5f1;color:#ff5a3c}.card button{margin-top:24rpx;background:#ff5a3c;color:#fff;border-radius:40rpx}.card .share{background:#fff;color:#ff5a3c;border:1rpx solid #ff5a3c}
