<view class="shell"><navigation-bar title="权限邀请" back="{{true}}"/><view class="page"><view wx:if="{{!token}}" class="card"><text class="title">生成邀请</text><text class="hint">邀请 24 小时内有效，只能由一人领取一次。</text><view class="roles"><view class="role {{role==='merchant'?'active':''}}" data-role="merchant" bindtap="choose">商户</view><view class="role {{role==='admin'?'active':''}}" data-role="admin" bindtap="choose">管理员</view></view><button loading="{{loading}}" bindtap="create">生成邀请卡片</button></view><view wx:else class="card"><text class="title">{{invite.role==='admin'?'管理员邀请':'商户邀请'}}</text><text class="hint">{{invite.creatorName}} 邀请你获得该权限</text><text class="state">{{invite.status==='pending'?'等待领取':invite.status==='accepted'?'已被领取':'已过期'}}</text><button wx:if="{{invite.status==='pending'&&!accepted}}" loading="{{loading}}" bindtap="accept">确认接受邀请</button><button wx:if="{{accepted}}" bindtap="goMine">进入我的页面</button><button wx:if="{{invite.status==='pending'&&!accepted}}" open-type="share" class="share">转发邀请</button></view></view></view>
