page { min-height: 100%; background: #f5f5f5; }
.detail-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 20rpx calc(180rpx + env(safe-area-inset-bottom)); }
.empty { padding-top: 240rpx; color: #999; text-align: center; }
.status-panel { padding: 30rpx 20rpx 38rpx; }
.status-title-row { display: flex; align-items: baseline; gap: 16rpx; }
.status-title { display: block; color: #222; font-size: 42rpx; font-weight: 700; }
.countdown { color: #f08330; font-size: 28rpx; font-variant-numeric: tabular-nums; }
.status-desc { display: block; margin-top: 10rpx; color: #888; font-size: 25rpx; }
.card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; }
.address-card { display: flex; align-items: center; }
.location-icon { width: 60rpx; color: #ff4a4a; font-size: 44rpx; }
.address-content { flex: 1; }
.contact-name { margin-right: 20rpx; color: #222; font-size: 30rpx; font-weight: 600; }
.contact-phone, .address-detail { color: #777; font-size: 25rpx; }
.address-detail { display: block; margin-top: 10rpx; line-height: 1.5; }
.shop-title { display: flex; align-items: center; padding-bottom: 20rpx; color: #222; font-size: 29rpx; font-weight: 600; }
.shop-icon { margin-right: 10rpx; padding: 2rpx 8rpx; border-radius: 6rpx; background: #ff4a4a; color: #fff; font-size: 20rpx; }
.goods-row { display: flex; margin-bottom: 22rpx; }
.goods-image { width: 128rpx; height: 128rpx; flex-shrink: 0; border-radius: 12rpx; background: #f2f2f2; }
.goods-info { display: flex; flex: 1; min-width: 0; justify-content: space-between; padding: 4rpx 18rpx; }
.goods-name { color: #222; font-size: 27rpx; line-height: 1.45; }
.goods-count { color: #999; font-size: 24rpx; }
.goods-price { color: #333; font-size: 27rpx; }
.amount-row, .info-row { display: flex; justify-content: space-between; padding-top: 18rpx; color: #666; font-size: 25rpx; }
.amount-row.total { margin-top: 18rpx; border-top: 1rpx solid #eee; color: #222; font-weight: 600; }
.amount-row.total text:last-child { color: #ff4a4a; font-size: 34rpx; }
.info-row text:first-child { width: 150rpx; flex-shrink: 0; color: #999; }
.info-row text:last-child { max-width: 480rpx; color: #555; text-align: right; word-break: break-all; }
.bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; display: flex; justify-content: flex-end; padding: 18rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -3rpx 18rpx rgba(0,0,0,.06); }
.bottom-actions button { height: 72rpx; margin: 0 0 0 16rpx; padding: 0 30rpx; border-radius: 36rpx; font-size: 26rpx; line-height: 70rpx; }
.bottom-actions button::after { border: 0; }
.plain-btn { border: 1rpx solid #ddd; background: #fff; color: #444; }
.pay-btn { background: #ff4a4a; color: #fff; }
