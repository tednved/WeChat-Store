<view class="orders-shell">
<navigation-bar title="我的订单" back="{{false}}" />
<scroll-view class="orders-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" enable-back-to-top="true" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh" bindscrolltolower="onReachBottom" lower-threshold="120">
<view class="orders-page">
  <block wx:if="{{loading}}">
    <view class="empty-tip">加载中...</view>
  </block>
  <block wx:elif="{{!loggedIn}}">
    <view class="empty-tip">请先登录后查看订单</view>
    <button class="login-btn" bindtap="goToLogin">去登录</button>
  </block>
  <block wx:elif="{{orders.length === 0}}">
    <view class="empty-tip">您还没有下过单哦~</view>
  </block>
  <block wx:else>
    <view class="order-card" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" bindtap="goOrderDetail">
      <view class="order-header">
        <view class="shop-title"><text class="shop-icon">店</text><text>{{item.storeName || '店铺'}}</text><text class="arrow">›</text></view>
        <view class="order-status-wrap"><text class="order-status {{item.refundStatus === 'refunded' ? 'refunded' : item.refundStatus === 'requesting' || item.refundStatus === 'processing' ? 'refunding' : item.status === 'paid' ? 'paid' : ''}}">{{item.statusText}}</text><text wx:if="{{item.status === 'pending' && item.remainSec > 0}}" class="countdown">{{item.remainText}}</text></view>
      </view>
      <view class="order-content">
        <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="goods">
          <image class="goods-image" src="{{goods.image}}" mode="aspectFill" />
          <view class="goods-main"><text class="goods-name">{{goods.name}}</text><text class="goods-count">x{{goods.count}}</text></view>
          <text class="goods-price">¥{{goods.price}}</text>
        </view>
      </view>
      <view class="summary-line"><text>共{{item.items.length}}种商品</text><text>合计：</text><text class="summary-price">¥{{item.totalPriceStr}}</text></view>
      <view class="order-footer">
        <view class="order-time-wrap"><text class="order-time">{{item.timeStr}}</text></view>
        <view class="footer-actions">
          <button wx:if="{{item.merchantPhone && item.status !== 'pending' && item.status !== 'cancelled'}}" class="contact-btn" data-id="{{item._id}}" catchtap="callMerchant">联系商户</button>
          <button wx:if="{{item.status === 'pending'}}" class="contact-btn" data-id="{{item._id}}" loading="{{cancellingId === item._id}}" disabled="{{cancellingId === item._id || payingId === item._id}}" catchtap="onCancelTap">取消订单</button>
          <button wx:if="{{item.status === 'pending' && item.remainSec > 0}}" class="pay-btn" data-id="{{item._id}}" catchtap="onPayTap">去支付</button>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多...</view><view wx:elif="{{!hasMore}}" class="load-more">已经到底了</view>
  </block>
</view>
</scroll-view>
</view>
